# Copia este archivo como ".env" y ajusta los valores. NO subas ".env" a GitHub.

PORT=3000

# URL del frontend (para CORS). Puedes poner varias separadas por coma.
FRONTEND_URL=http://localhost:5173

# Credenciales de Firebase Admin (elige UNA opción):
# Opción A: ruta al archivo descargado desde Firebase (Configuración > Cuentas de servicio)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Opción B (para hosting): el JSON completo en una sola línea
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}

# Zona horaria usada para "hoy" y los rangos de fechas en reportes
ZONA_HORARIA=America/Lima
OFFSET_HORARIO=-05:00
